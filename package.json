{
  "name": "sinapsis-backend-checkpoint",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Technical Checkpoint for Sinapsis: Serverless API (Node.js + TypeScript + Express on AWS Lambda) with MySQL, OpenAPI documentation, and SMS marketing campaign reporting. Hexagonal architecture + DDD.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node init && serverless package",
    "dev": "node init && serverless offline --httpPort 3000",
    "migrate": "knex migrate:latest --knexfile src/infrastructure/adapter/output/persistence/database/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/infrastructure/adapter/output/persistence/database/knexfile.ts",
    "migrate:status": "knex migrate:status --knexfile src/infrastructure/adapter/output/persistence/database/knexfile.ts",
    "seed": "knex seed:run --knexfile src/infrastructure/adapter/output/persistence/database/knexfile.ts",
    "db:reset": "npm run migrate:rollback -- --all && npm run migrate && npm run seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.{json,yaml,yml,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docs:lint": "redocly lint docs/openapi.yaml",
    "docs:build": "redocly build-docs docs/openapi.yaml -o docs/openapi-preview.html",
    "docs:swagger": "node scripts/build-swagger-ui.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "mysql2": "^3.11.5",
    "serverless-http": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.11",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@types/aws-lambda": "^8.10.146",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.0",
    "serverless-offline": "^13.9.0",
    "supertest": "^7.0.0",
    "swagger-ui-dist": "^5.35.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "aws-sdk@2.1693.0": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.24.2": true,
    "serverless@3.40.0": true,
    "core-js@3.32.1": true
  }
}
