{
  "info": {
    "name": "Sinapsis Backend Checkpoint",
    "description": "Colección de validación end-to-end para la prueba técnica Backend Semi-Senior de Sinapsis. Pensada para correr contra `npm run dev` (serverless-offline) con la base de datos ya migrada y sembrada (`npm run migrate && npm run seed`). Los valores esperados en los tests coinciden con docs/database/seed.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health -> 200 ok",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body status is ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "GET /reports/messages-by-status mes=2026-11&idCliente=1 -> 200 (total 6)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/messages-by-status?mes=2026-11&idCliente=1",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "messages-by-status"],
              "query": [
                { "key": "mes", "value": "2026-11" },
                { "key": "idCliente", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('resumen y total coinciden con el seed (Pendiente=2, Enviado=3, Error=1, total=6)', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.mes).to.eql('2026-11');",
                  "  pm.expect(body.idCliente).to.eql(1);",
                  "  pm.expect(body.total).to.eql(6);",
                  "  pm.expect(body.resumen).to.have.lengthOf(3);",
                  "  const porEstado = Object.fromEntries(body.resumen.map((r) => [r.estado, r.cantidad]));",
                  "  pm.expect(porEstado.Pendiente).to.eql(2);",
                  "  pm.expect(porEstado.Enviado).to.eql(3);",
                  "  pm.expect(porEstado.Error).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
