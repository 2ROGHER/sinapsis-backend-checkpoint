    {
      "name": "Campañas",
      "item": [
        {
          "name": "POST /campaigns (éxito) -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idUsuario\": 1,\n  \"nombre\": \"Campaña de prueba Postman\",\n  \"fechaHoraProgramacion\": \"2027-03-25T09:00:00.000Z\",\n  \"mensajes\": [\n    { \"mensaje\": \"Hola! Este es un mensaje de prueba\", \"fechaHoraEnvio\": \"2027-03-25T09:05:00.000Z\" },\n    { \"mensaje\": \"Segundo mensaje de la campaña de prueba\", \"fechaHoraEnvio\": \"2027-03-25T18:00:00.000Z\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["campaigns"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('campaña creada con 2 mensajes y estado Pendiente', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.idCampania).to.be.a('number');",
                  "  pm.expect(body.mensajes).to.have.lengthOf(2);",
                  "  body.mensajes.forEach((m) => {",
                  "    pm.expect(m.idMensaje).to.be.a('number');",
                  "    pm.expect(m.estadoEnvio).to.eql(1);",
                  "    pm.expect(m.estado).to.eql(1);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
