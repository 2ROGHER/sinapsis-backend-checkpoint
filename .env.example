# Copia este archivo a .env y ajusta los valores para tu entorno local.
# En AWS real, estas variables se inyectan vía serverless.yml (provider.environment)
# y SSM Parameter Store — ver docs/DEPLOY.md. Nunca commitear un .env real.

NODE_ENV=development
STAGE=dev # Importante el stage, puede existir mas de un stage 'dev', 'prod', 'test', 'staging', etc.

# Conexión MySQL — apunta a tu servidor MySQL 8.x local o remoto.
# La base de datos debe existir antes de correr `npm run migrate`
# (ver docs/LOCAL_SETUP.md).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_local
DB_NAME=sips_checkpoint_db_dev

# Pool de conexiones Knex — bajo a propósito por el modelo de ejecución en Lambda
# (ver docs/ARCHITECTURE.md, sección "Conexión MySQL en Lambda")
DB_POOL_MIN=0
DB_POOL_MAX=2

# Puerto HTTP local para `npm run dev` (serverless-offline)
HTTP_PORT=3000
